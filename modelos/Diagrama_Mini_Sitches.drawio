        <mxCell id="nota0" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#FEF9F3;strokeColor=#422518;spacing=8;fontSize=11;" value="SQLite 3 — convenções adotadas INTEGER PRIMARY KEY AUTOINCREMENT = rowid, id estável Dinheiro: INTEGER em centavos (sem erro de ponto flutuante) Booleano: INTEGER 0/1 com CHECK Data/hora: TEXT em ISO 8601 (AAAA-MM-DD ou UTC) Enums: TEXT + CHECK (SQLite não tem ENUM) Amarelo = PK · Rosa = FK · Cinza = CHECK · Azul = índice  PRAGMA foreign_keys = ON;  -- obrigatório a cada conexão PRAGMA journal_mode = WAL; PRAGMA busy_timeout = 5000;" vertex="1">
